# Переопределения для docker-compose.yml. Копировать в .env нужно, только если
# что-то меняете: без .env работают значения по умолчанию из compose.
# Если меняете логин, пароль или порты — поправьте и apps/server/.env.
# POSTGRES_USER=fanera
# POSTGRES_PASSWORD=fanera
# POSTGRES_DB=fanera
# POSTGRES_PORT=5432
# REDIS_PORT=6379
