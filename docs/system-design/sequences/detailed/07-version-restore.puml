@startuml 07-version-restore
!include ../_style.iuml
title Восстановление версии, пока на доске работают люди (Р-37)\n(architecture/README §3.3 · deep-dive §5)

actor "Редактор" as U
participant "api" as API
queue "Redis queue" as Q
participant "worker" as W
participant "LB\n(внутренний listener,\nhash boardId)" as LB
participant "collab-инстанс\nс документом" as COL
database "PG collab" as PG
database "S3" as S3
queue "Redis realtime" as R
actor "Другие участники" as O

U -> API : POST /versions/{v}/restore\nIdempotency-Key
API -> Q : add job restore-{requestId}
API --> U : 202

Q -> W : job restore-{requestId}
W -> LB : внутренний вызов restore(boardId, v, requestId)
LB -> COL : тот же инстанс, что держит WebSocket доски
activate COL
opt документ нигде не открыт
  COL -> PG : загрузить документ (DocumentLoader)
end
COL -> PG : BEGIN; pg_try_advisory_xact_lock(boardId)
alt lock не взят
  COL --> W : 409 — восстановление уже идёт
else lock взят
  opt уже есть restore_applied_at для requestId
    COL --> W : 200 — повтор джобы, выходим
  end
  COL -> PG : сбросить буфер правок доски в board_updates
  COL -> S3 : GET снапшот версии v
  S3 --> COL : versionUpdate
  COL -> COL : синхронно, без await:\npre = encodeStateAsUpdate(doc);\nrestoreTo(doc, versionUpdate) — минимальная разница\n«текущее → старое» одной транзакцией Yjs
  note right of COL : между снимком и применением\nчужая правка не влезет.\nПочинки §17 этой доски\nотложены до конца шага
  COL -> S3 : PUT pre (уже захваченные байты)
  COL -> PG : INSERT board_versions (kind = pre_restore, restore_request_id);\nINSERT board_updates (обновление восстановления);\nrestore_applied_at; COMMIT (lock снят)
  alt PUT или COMMIT упал
    COL -> COL : выгрузить документ: не принимать правки доски,\nвыбросить Y.Doc (восстановление никуда не разослано)
    COL -> O : disconnect «переподключись»
    note right of O : буфер правок участников пишется обычным путём;\nнедописанное клиенты дошлют через sync:step1.\nДокумент загрузится из БД без восстановления
    COL --> W : 5xx — ретрай джобы BullMQ
  else записано
    COL -> O : doc:update {restore diff} — только после COMMIT
    COL -> R : PUBLISH collab:doc:{boardId}
    COL -> O : version:restored {versionId, by, preRestoreVersionId}
    COL -> U : version:restored
    COL --> W : 200
  end
end
deactivate COL
note over U, O : никого не отключаем (кроме сбоя записи); параллельные правки сливаются по правилам CRDT,\n«удаление побеждает правку» (Р-13): правка, пришедшая до рассылки восстановления\nна удаляемый элемент, пропадёт. Откат = восстановить pre_restore
@enduml
