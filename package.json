{
  "name": "fanera",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format:server": "pnpm --filter server format",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter web exec next typegen && pnpm -r typecheck",
    "test:web": "pnpm --filter web test",
    "test:server": "pnpm --filter server test",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "test:e2e:server": "pnpm --filter server test:e2e"
  },
  "packageManager": "pnpm@12.18.0"
}
