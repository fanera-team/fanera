{
  "name": "fanera",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --parallel --filter web --filter @fanera/contracts dev",
    "dev:server": "pnpm --parallel --filter server --filter @fanera/contracts dev",
    "build": "pnpm -r build",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "lint:eslint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:oxlint": "pnpm --filter server lint",
    "lint:fix": "eslint . --fix && pnpm --filter server lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm --filter web test",
    "test:server": "pnpm --filter server test",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "test:e2e:server": "pnpm --filter server test:e2e",
    "storybook": "pnpm --filter web storybook"
  },
  "devDependencies": {
    "@conarti/eslint-plugin-feature-sliced": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@12.18.0",
  "lint-staged": {
    "apps/server/**/*.{ts,tsx}": [
      "pnpm --filter server exec oxlint --type-aware --fix"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
