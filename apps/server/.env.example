# Скопируйте в .env: cp .env.example .env
# Все переменные проверяются при старте (src/config/env.schema.ts):
# если значение некорректно, сервер не запустится и напишет, что не так.

# Порт каждой роли: локально три процесса идут рядом, в docker — свой контейнер.
# 3000 занят dev-сервером фронта (Vite).
API_PORT=3001
COLLAB_PORT=3002
WORKER_PORT=3003

# Origin фронта, которому браузер разрешит запросы к API (CORS).
WEB_ORIGIN=http://localhost:3000

# Postgres и Redis из docker-compose.yml в корне (docker compose up -d).
# Логин, пароль и порты должны совпадать с compose (по умолчанию fanera/fanera).
DATABASE_URL=postgresql://fanera:fanera@localhost:5432/fanera
REDIS_URL=redis://localhost:6379

# База для e2e-тестов (pnpm test:e2e). По умолчанию fanera_test в том же Postgres;
# раскомментируйте, если Postgres на другом порту. Базу создаст prisma migrate deploy.
# TEST_DATABASE_URL=postgresql://fanera:fanera@localhost:5432/fanera_test
