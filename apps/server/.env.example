# Скопируйте в .env: cp .env.example .env
# Все переменные проверяются при старте (src/config/env.schema.ts):
# если значение некорректно, сервер не запустится и напишет, что не так.

# 3000 занят Next.js
PORT=3001

# Origin фронта, которому браузер разрешит запросы к API (CORS).
WEB_ORIGIN=http://localhost:3000
