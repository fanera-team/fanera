{
  "name": "server",
  "version": "0.1.0",
  "description": "Fanera API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "pnpm --filter @fanera/contracts build && nest build",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --type-aware --fix src/ test/",
    "test": "pnpm --filter @fanera/contracts build && vitest run",
    "test:watch": "pnpm --filter @fanera/contracts build && vitest",
    "test:cov": "pnpm --filter @fanera/contracts build && vitest run --coverage",
    "test:e2e": "pnpm --filter @fanera/contracts build && vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "pnpm --filter @fanera/contracts build && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:migrate:deploy": "prisma generate && prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fanera/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "catalog:default",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
